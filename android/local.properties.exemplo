# Copie este arquivo para "local.properties" (esse arquivo NAO vai para o git).

# Caminho do Android SDK (o Android Studio costuma preencher sozinho):
sdk.dir=C\:\Users\SEU_USUARIO\AppData\Local\Android\Sdk

# Endereco e chave PUBLICA do Supabase (as mesmas do site).
# Somente a chave PUBLICA (publishable ou anon). A secret/service_role nunca entra no aplicativo.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_sua-chave-publica

# Conta dedicada do aplicativo do barbeiro. O app entra sozinho com ela,
# sem tela de login. Crie o usuario no Supabase (Authentication > Users),
# use uma senha longa e aleatoria, e libere-o na tabela administradores.
BARBEIRO_EMAIL=app@barbeariaarte10.com.br
BARBEIRO_SENHA=troque-por-uma-senha-longa-e-aleatoria
