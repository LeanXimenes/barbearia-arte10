<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Arte10" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/azul_profundo</item>
        <item name="android:navigationBarColor">@color/azul_profundo</item>
        <item name="android:windowBackground">@color/azul_profundo</item>
    </style>

    <style name="Theme.Arte10.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/azul_logo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Arte10</item>
        <item name="android:windowBackground">@color/azul_profundo</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/azul_profundo</item>
    </style>
</resources>
