# ---------------------------------------------------------------------
# Barbearia Arte 10 — variaveis do site publico
# ---------------------------------------------------------------------
# Copie para ".env" (desenvolvimento) e cadastre as mesmas chaves em
# Site settings > Environment variables no Netlify (producao).
#
# ATENCAO: aqui entra SOMENTE a chave "anon" (publica).
# A service_role key NUNCA pode aparecer no site.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
