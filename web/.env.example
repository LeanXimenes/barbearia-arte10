# ---------------------------------------------------------------------
# Barbearia Arte 10 — variaveis do site publico
# ---------------------------------------------------------------------
# Copie para ".env" (desenvolvimento) e cadastre as mesmas chaves em
# Site settings > Environment variables no Netlify (producao).
#
# ATENCAO: aqui entra SOMENTE a chave PUBLICA: a "publishable"
# (sb_publishable_...) ou a antiga "anon". A secret/service_role NUNCA.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publica
